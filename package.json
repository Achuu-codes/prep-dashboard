{
  "name": "prep-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run notes && npm run db:ensure && next dev",
    "build": "npm run notes && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:ensure": "tsx scripts/ensure-db.ts",
    "ratings": "tsx scripts/fetch-ratings.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:offline": "tsx scripts/seed.ts --offline",
    "setup": "npm run db:ensure && npm run ratings && npm run seed && npm run notes",
    "notes": "tsx scripts/gen-notes.ts"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "^16.4.6",
    "@shikijs/rehype": "^3.13.0",
    "drizzle-orm": "0.44.6",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shiki": "3.13.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/mdx": "2.0.13",
    "@types/node": "24.7.0",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.5",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "@tailwindcss/oxide@4.1.14": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true
  }
}
