# ============================================================================
#  Copy to .env.local and fill in. Nothing here is sent to the browser:
#  every value is read only in server code (src/lib/env.ts is `server-only`).
# ============================================================================

# ---- Database --------------------------------------------------------------
# Local SQLite file (default). Switch to Turso for deployment by changing this
# to libsql://<db>-<org>.turso.io and setting DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
# DATABASE_AUTH_TOKEN=

# ---- Login (single user) ---------------------------------------------------
# Leave both blank and the site runs with no login — fine for localhost only.
# Set BOTH before deploying, or the whole site is public.
#   AUTH_SECRET: any long random string, e.g. `openssl rand -base64 32`
APP_PASSWORD=
AUTH_SECRET=

# ---- Who you are (shown on the dashboard) ----------------------------------
OWNER_NAME=Your Name
OWNER_TAGLINE=Preparing for software engineering interviews
# OWNER_EMAIL=
# OWNER_WEBSITE=https://example.com

# ---- LeetCode --------------------------------------------------------------
# Public handle: everything except the full solved list works with just this.
LEETCODE_USERNAME=

# Optional. Unlocks your complete solved-problem list instead of only the last
# ~20 accepted submissions. Both cookies come from a logged-in leetcode.com
# session (DevTools -> Application -> Cookies). They expire every few weeks;
# the dashboard shows a warning when they stop working.
# LEETCODE_SESSION=
# LEETCODE_CSRF=

# ---- GitHub ----------------------------------------------------------------
# A read-only classic PAT or fine-grained token. Scopes needed: `read:user`,
# plus `public_repo` if you want private contribution counts included.
GITHUB_USERNAME=
GITHUB_TOKEN=

# ---- Cron ------------------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/sync.
# If unset, that route only answers on localhost.
CRON_SECRET=
